# create-api-key-secret.sh
#!/bin/bash

# 사용법: ./create-api-key.sh [namespace] [environment]
# 예: ./create-api-key.sh qdrant dev
# 예: ./create-api-key.sh qdrant prod

NAMESPACE="${1:-qdrant}"
ENV="${2:-dev}"
SECRET_NAME="qdrant-api-key"

# 네임스페이스 존재 확인
if ! kubectl get namespace ${NAMESPACE} &> /dev/null; then
    echo "네임스페이스 '${NAMESPACE}'가 존재하지 않습니다. 생성합니다..."
    kubectl create namespace ${NAMESPACE}
fi

# 강력한 API Key 생성
API_KEY=$(openssl rand -base64 32)

echo "========================================="
echo "  Qdrant API Key Secret 생성"
echo "========================================="
echo "환경: ${ENV}"
echo "네임스페이스: ${NAMESPACE}"
echo "Secret 이름: ${SECRET_NAME}"
echo ""
echo "생성된 API Key:"
echo "${API_KEY}"
echo ""
echo "⚠️  이 키를 안전한 곳에 보관하세요!"
echo "========================================="
echo ""

# Secret 생성
kubectl create secret generic ${SECRET_NAME} \
  --from-literal=api-key=${API_KEY} \
  --namespace ${NAMESPACE} \
  --dry-run=client -o yaml | kubectl apply -f -

if [ $? -eq 0 ]; then
    echo "✓ Secret '${SECRET_NAME}' 생성 완료"
    echo ""
    echo "values-${ENV}.yaml에서 다음과 같이 설정하세요:"
    echo ""
    echo "apiKey:"
    echo "  enabled: true"
    echo "  value: \"\"  # 비워둠"
    echo "  existingSecret: \"${SECRET_NAME}\""
    echo "  existingSecretKey: \"api-key\""
    echo ""
    echo "또는 Helm 설치 시:"
    echo "helm install qdrant ./qdrant-chart \\"
    echo "  --namespace ${NAMESPACE} \\"
    echo "  --set apiKey.enabled=true \\"
    echo "  --set apiKey.existingSecret=${SECRET_NAME}"
else
    echo "✗ Secret 생성 실패"
    exit 1
fi