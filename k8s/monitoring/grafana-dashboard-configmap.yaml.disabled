apiVersion: v1
kind: ConfigMap
metadata:
  name: ecommerce-lab-dashboard
  namespace: ecommerce-lab
  labels:
    grafana_dashboard: "1"
data:
  ecommerce-lab-dashboard.json: |
    {
      "annotations": {
        "list": []
      },
      "editable": true,
      "panels": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS"
          },
          "title": "Order Requests",
          "type": "timeseries",
          "targets": [
            {
              "expr": "sum(rate(http_server_requests_seconds_count{job=~\".*order.*\",uri=~\"/api/orders.*\"}[1m]))"
            }
          ]
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS"
          },
          "title": "Payment Confirm Count",
          "type": "timeseries",
          "targets": [
            {
              "expr": "sum(rate(http_server_requests_seconds_count{job=~\".*payment.*\",uri=~\"/api/payments/.*/confirm\"}[1m]))"
            }
          ]
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS"
          },
          "title": "Order API P95 Latency",
          "type": "timeseries",
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=~\".*order.*\"}[5m])) by (le))"
            }
          ]
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROMETHEUS_DS"
          },
          "title": "Order Pod Memory Usage",
          "type": "timeseries",
          "targets": [
            {
              "expr": "sum(container_memory_working_set_bytes{pod=~\"order-service-.*\"})"
            }
          ]
        }
      ],
      "schemaVersion": 39,
      "style": "dark",
      "templating": {
        "list": []
      },
      "time": {
        "from": "now-15m",
        "to": "now"
      },
      "title": "E-Commerce Lab",
      "version": 1
    }
