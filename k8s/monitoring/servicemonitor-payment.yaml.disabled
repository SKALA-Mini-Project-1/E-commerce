apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: payment-service
  namespace: ecommerce-lab
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: payment-service
  namespaceSelector:
    matchNames:
      - ecommerce-lab
  endpoints:
    - port: http
      path: /actuator/prometheus
      interval: 15s
